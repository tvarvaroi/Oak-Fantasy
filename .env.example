# Oak Fantasy — environment variables template
# Copy to .env.local (gitignored) and fill with real values. NEVER commit .env.local.

# ── Supabase (public — safe to expose to the browser) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Supabase service role (SERVER ONLY — never NEXT_PUBLIC_, never client) ───
# Used by 'use server' actions / route handlers (guest orders, stock writes).
# Bypasses Row Level Security — keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Date firmă — OVERRIDE OPȚIONAL (nu sunt necesare) ───────────────────────
# Din 2026-07-15 valorile reale sunt hardcodate ca DEFAULT în lib/legal-info.ts
# (date publice de registru, finale). Site-ul le afișează fără niciun env.
# Variabilele de mai jos există DOAR ca override punctual dacă o valoare se
# schimbă vreodată înainte de a ajunge codul în producție. NU trebuie puse în
# Vercel. Valorile curente, pentru referință:
# ⚠ OMISE PERMANENT public (decizie founder): reprezentant legal, IBAN,
#   adresa atelierului (narativ: „vestul României").
# NEXT_PUBLIC_COMPANY_NAME=ROOBO PELLETS S.R.L
# NEXT_PUBLIC_COMPANY_CUI=39549528
# NEXT_PUBLIC_COMPANY_REG_COM=J2018001030021
# NEXT_PUBLIC_COMPANY_ADDRESS=Str. Orion nr. 24, Arad, jud. Arad
# NEXT_PUBLIC_COMPANY_CAPITAL=200 RON
# NEXT_PUBLIC_COMPANY_VAT_STATUS=neplătitor de TVA
# NEXT_PUBLIC_COMPANY_CAEN=3109
# NEXT_PUBLIC_CONTACT_PHONE=+40 774 905 182
# NEXT_PUBLIC_CONTACT_EMAIL=oakfantasy2026@gmail.com

# ── Reserved for later Etape (3–5) — add when those features land ────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# RESEND_API_KEY=
# SAMEDAY_API_KEY=
# SMARTBILL_API_KEY=
# NETOPIA_API_KEY=
